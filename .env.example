# Copy this file to `.env` (in the project root or in backend/) and fill in your key.
# NEVER commit the real .env file. The key is only ever read by the FastAPI backend.

ANTHROPIC_API_KEY=your_api_key_here

# Model used for diagnosis (any Claude model with vision support enables screenshot analysis)
ANTHROPIC_MODEL=claude-sonnet-5-5

# auto  = use Claude if ANTHROPIC_API_KEY is set, otherwise run the built-in demo (mock) AI
# live  = always use Claude (errors if no key)
# mock  = always use the demo AI (no network, canned answers, cannot read screenshots)
AI_MODE=auto

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional tuning
MAX_IMAGE_MB=5
AI_TIMEOUT_SECONDS=60
MAX_ATTEMPTS=5
MOCK_DELAY_SECONDS=1.8
# DATABASE_PATH=backend/data/fixflow.db
